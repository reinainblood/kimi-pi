		"check": "tsgo --noEmit"
	},
	"keywords": [
		"pi-package",
		"kimi",
		"coding-agent",
		"resource-accounting"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/reinainblood/kimi-pi.git",
		"directory": "packages/kimi-pi"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
