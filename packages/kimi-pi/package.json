{
	"name": "@reinainblood/kimi-pi",
	"version": "0.1.0",
	"description": "Kimi-focused Pi distribution with persistent resource accounting and output-limit recovery",
	"type": "module",
	"bin": {
		"kimi-pi": "bin/kimi-pi.js"
	},
	"pi": {
		"extensions": [
			"./src/resource-ledger.ts"
		]
	},
	"scripts": {
		"clean": "echo 'nothing to clean'",
